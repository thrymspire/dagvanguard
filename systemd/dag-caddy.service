[Unit]
Description=dagvanguard Caddy (static + local reverse proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__DAGVANGUARD_ROOT__
ExecStart=/usr/bin/caddy run --config __DAGVANGUARD_ROOT__/config/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config __DAGVANGUARD_ROOT__/config/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3

MemoryMax=256M
CPUQuota=50%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dag-caddy

[Install]
WantedBy=default.target
