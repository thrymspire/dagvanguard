[Unit]
Description=dagtko Domain API (port 8000)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=simple
WorkingDirectory=__DAGVANGUARD_ROOT__
EnvironmentFile=-__DAGVANGUARD_ROOT__/config/env
ExecStart=__DAGVANGUARD_ROOT__/scripts/start-dagtko.sh api
Restart=always
RestartSec=5

# Resource soft limits
MemoryMax=1G
CPUQuota=200%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dag-api

[Install]
WantedBy=default.target
