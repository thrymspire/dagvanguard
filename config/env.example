# dagvanguard environment
# Copy to config/env and edit.

# Where the dagtko repository lives on this machine
DAGTKO_ROOT=/home/droid/dagtko

# Domain
DOMAIN=stacktaskservices.systems

# Cloudflare (fill after you create the tunnel – see docs/01-CLOUDFLARE-SETUP.md)
# Option A – preferred: use a Tunnel Token (simpler)
CLOUDFLARE_TUNNEL_TOKEN=

# Option B – classic credentials file (if you prefer)
# CLOUDFLARE_TUNNEL_ID=
# CLOUDFLARE_CREDENTIALS_FILE=$HOME/.cloudflared/<TUNNEL_ID>.json

# Optional: Cloudflare API Token with Zone.DNS Edit permission
# Used by the IP watcher to automatically update the A record
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Notification (choose one or leave empty for file-only)
# Telegram example:
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC...
# NOTIFY_TELEGRAM_CHAT_ID=987654321

# Generic webhook (Discord, Slack, ntfy, etc.)
# NOTIFY_WEBHOOK_URL=https://...

# How often the IP watcher runs (systemd timer already set to 5 min)
# This is just documentation; the timer controls the real schedule.
